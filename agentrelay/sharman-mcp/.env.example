# SHARMAN uses the AWS SDK default credential provider chain.
# Do not place AWS access keys in this file or commit them to source control.
AWS_REGION=us-east-1
SHARMAN_AWS_BEDROCK_ENABLED=false
SHARMAN_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Configure Ring values in the process environment or a local secret manager.
# A signing key, account ID and device ID are all required for /webhooks/ring.
SHARMAN_RING_SIGNING_KEY=
SHARMAN_RING_ACCOUNT_ID=
SHARMAN_RING_DEVICE_ID=
# Enables unsigned, explicitly labelled test payloads on loopback only.
SHARMAN_RING_TEST_EVENTS_ENABLED=false

# Official Playground token, generated in the Amazon Developer Playground.
# Read at runtime only; never commit or paste a real token into this template.
RING_ENVIRONMENT=playground
RING_ACCESS_TOKEN=
