{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sharman",
  "version": "0.22.1-alpha.1",
  "identifier": "com.agentrelay.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sharman · Local Assistant",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "publisher": "Sharman",
    "shortDescription": "Local assistant and multi-agent coordination for Windows",
    "longDescription": "Sharman is a local-first Windows assistant for files, media, websites, and project progress. AgentRelay provides its specialist multi-agent development memory and coordination layer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "startMenuFolder": "Sharman",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
