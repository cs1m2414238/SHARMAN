{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadLoadBalancerAccountPrerequisite",
      "Effect": "Allow",
      "Action": "ec2:DescribeAccountAttributes",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-southeast-2" } }
    },
    {
      "Sid": "ReadProvisioningAlarmState",
      "Effect": "Allow",
      "Action": "cloudwatch:DescribeAlarms",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-southeast-2" } }
    },
    {
      "Sid": "CreateOnlyJudgingTargetTrackingAlarms",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricAlarm",
      "Resource": "arn:aws:cloudwatch:ap-southeast-2:926642724277:alarm:TargetTracking-service/sharman-judging/sharman-amazon-demo-*"
    },
    {
      "Sid": "CoordinateOnlyTheJudgingService",
      "Effect": "Allow",
      "Action": ["ecs:DescribeServices", "ecs:UpdateService"],
      "Resource": "arn:aws:ecs:ap-southeast-2:926642724277:service/sharman-judging/sharman-amazon-demo"
    }
  ]
}
